<Window x:Class="LedMenu.App.Display.IdentifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Background="#FF101820" Width="400" Height="225"
        WindowStartupLocation="Manual" Left="0" Top="0">
    <Border BorderBrush="#FFFFC400" BorderThickness="6" Padding="12">
        <Viewbox>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="NumberText" FontSize="160" FontWeight="Bold" Foreground="#FFFFC400"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="NameText" FontSize="30" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DetailText" FontSize="22" Foreground="#FFB0B8C0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Viewbox>
    </Border>
</Window>
