<Window x:Class="LedMenu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LedMenu.App.Controls"
        xmlns:local="clr-namespace:LedMenu.App"
        Title="LED Menu Control" Height="800" Width="1480" MinHeight="560" MinWidth="1000"
        Background="#FF1E1E1E" Foreground="#FFEDEDED">
    <Window.InputBindings>
        <KeyBinding Key="F12" Modifiers="Ctrl+Shift" Command="{Binding Output.StopCommand}"/>
        <KeyBinding Key="I" Modifiers="Ctrl+Shift" Command="{Binding Output.ToggleIdentifyCommand}"/>
        <KeyBinding Key="B" Modifiers="Ctrl+Shift" Command="{Binding Output.BlackoutCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
        </Style>
        <!-- dropdown text: the window-wide light TextBlock style would otherwise make it unreadable on the white list -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FF111111"/>
            <Setter Property="Background" Value="White"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FF111111"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A9A"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="16,12">
            <Border DockPanel.Dock="Right" Background="#FF3A3A3A" CornerRadius="4" Padding="12,4">
                <TextBlock Foreground="#FFEDEDED" Text="{Binding Displays.OutputChip}" FontWeight="Bold" FontSize="14"/>
            </Border>
            <TextBlock Foreground="#FFEDEDED" Text="LED MENU CONTROL" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <!-- Recovery / startup notice -->
            <Border Background="#FF8A5A00" Padding="16,8" Margin="16,0,16,8"
                    Visibility="{Binding HasStartupNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2"
                            Command="{Binding DismissNoticeCommand}"/>
                    <TextBlock Foreground="#FFEDEDED" Text="{Binding StartupNotice}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- LED output controls -->
            <Border Margin="16,0,16,10" Padding="14,10" Background="#FF262626" BorderBrush="#FF4A4A4A" BorderThickness="1"
                    DataContext="{Binding Output}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="Start Output" Padding="18,8" FontWeight="Bold" Margin="0,0,8,0"
                                    Command="{Binding StartCommand}"/>
                            <Button Content="Stop Output" Padding="18,8" FontWeight="Bold" Margin="0,0,24,0"
                                    Command="{Binding StopCommand}"/>
                            <Button Padding="18,8" FontWeight="Bold" Command="{Binding BlackoutCommand}" ToolTip="Ctrl+Shift+B"
                                    AutomationProperties.AutomationId="BlackoutButton" Content="{Binding BlackoutButtonText}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#FFB23A3A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlackout}" Value="True">
                                                <Setter Property="Background" Value="#FFC62828"/>
                                            </DataTrigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="#FF777777"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Margin="24,0,0,0" Padding="14,8" Content="{Binding PreviewVideoText}" Command="{Binding ToggleVideoPreviewCommand}"
                                    Visibility="{Binding HasVideoScreens, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Plays the videos in the preview panel while the LED output is stopped, to check a playlist at the desk. Nothing goes to any display."
                                    AutomationProperties.AutomationId="PreviewVideos"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="Stop output at any time: Ctrl+Shift+F12     Blackout: Ctrl+Shift+B     All shortcuts: Help tab"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Output shows:" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource Dim}"/>
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" Content="Normal Output" GroupName="OutMode" Padding="12,5" Margin="0,0,6,0"
                                     IsChecked="{Binding IsNormalMode, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="Normal"/>
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" Content="Identify Screens" GroupName="OutMode" Padding="12,5" Margin="0,0,6,0"
                                     IsChecked="{Binding IsIdentifyMode, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="IdentifyScreens"
                                     ToolTip="Ctrl+Shift+I"/>
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" Content="Screen Calibration" GroupName="OutMode" Padding="12,5" Margin="0,0,6,0"
                                     IsChecked="{Binding IsScreenCalibrationMode, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="ScreenCalibration"/>
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" Content="Output Canvas Calibration" GroupName="OutMode" Padding="12,5"
                                     IsChecked="{Binding IsCanvasCalibrationMode, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="OutputCanvasCalibration"/>
                    </StackPanel>
                    <Border Background="#FFC62828" Padding="12,10" Margin="0,10,0,0"
                            Visibility="{Binding IsBlackout, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BlackoutBannerText}" TextWrapping="Wrap" FontWeight="Bold" FontSize="15" Foreground="White"/>
                    </Border>
                    <Border Background="#FFB000B0" Padding="12,8" Margin="0,10,0,0"
                            Visibility="{Binding IsTestMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ModeBannerText}" TextWrapping="Wrap" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Border Background="#FF8A5A00" Padding="12,6" Margin="0,6,0,0"
                            Visibility="{Binding HasContentWarnings, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="#FFEDEDED" Text="{Binding ContentWarnings}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#FF7A1F1F" Padding="12,6" Margin="0,6,0,0"
                            Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="#FFEDEDED" Text="{Binding SkippedText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#FF8A5A00" Padding="12,6" Margin="0,10,0,0"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2" Margin="12,0,0,0"
                                    Command="{Binding DismissMessageCommand}"/>
                            <TextBlock Foreground="#FFEDEDED" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Tabs -->
        <Grid Grid.Row="2" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        <TabControl Grid.Column="0" Margin="0,0,10,0" Background="#FF1E1E1E" BorderBrush="#FF4A4A4A" TextElement.Foreground="#FFEDEDED" SelectionChanged="Tabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FFEDEDED"/>
                </Style>
                <Style TargetType="CheckBox">
                    <Setter Property="Foreground" Value="#FFEDEDED"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Menu">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                    <StackPanel DataContext="{Binding Editor}">
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource ActionButton}" Content="Add Category" Command="{Binding AddCategoryCommand}"/>
                                <Button Style="{StaticResource ActionButton}" Margin="0" Content="Add Item" Command="{Binding AddLooseItemCommand}"/>
                            </StackPanel>
                            <TextBlock Foreground="#FFEDEDED" Text="MENU" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox Width="280" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      ItemsSource="{Binding MenuChoices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedMenuId}"/>
                        </DockPanel>

                        <TextBlock Foreground="#FFEDEDED" Text="No menus yet. Open the Menu Library tab to create one." Margin="0,0,0,10"
                                   Visibility="{Binding HasNoMenu, Converter={StaticResource BoolToVis}}"/>

                        <Border Background="#FF7A1F1F" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2" Margin="12,0,0,0" Command="{Binding DismissMessageCommand}"/>
                                <TextBlock Foreground="#FFEDEDED" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Background="#FF8A5A00" Padding="12,6" Margin="0,0,0,8"
                                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="#FFEDEDED" Text="{Binding Problems}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Style="{StaticResource Dim}" Text="{Binding Info}" Margin="0,0,0,8"
                                   Visibility="{Binding HasMenu, Converter={StaticResource BoolToVis}}"/>

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="10" Background="#FF262626" BorderBrush="#FF4A4A4A" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8" Opacity="{Binding RowOpacity}">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="Hide Category" Padding="8,3" Margin="0,0,6,0"
                                                            Command="{Binding ToggleVisibleCommand}"
                                                            Visibility="{Binding Model, Converter={StaticResource NullToCollapsed}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                        <Setter Property="Content" Value="Show Category"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Delete" Padding="8,3" Margin="0,0,6,0" Command="{Binding DeleteCommand}"
                                                            Visibility="{Binding Model, Converter={StaticResource NullToCollapsed}}"/>
                                                    <Button Content="+ Add Item" Padding="10,3" FontWeight="SemiBold" Command="{Binding AddItemCommand}"/>
                                                </StackPanel>
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0"
                                                            Visibility="{Binding Model, Converter={StaticResource NullToCollapsed}}">
                                                    <Button Content="&#9650;" Padding="7,2" Margin="0,0,3,0" Command="{Binding MoveUpCommand}" ToolTip="Move category up"/>
                                                    <Button Content="&#9660;" Padding="7,2" Command="{Binding MoveDownCommand}" ToolTip="Move category down"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="17" FontWeight="Bold" Padding="4,2"
                                                         IsReadOnly="{Binding IsUncategorized}"
                                                         LostKeyboardFocus="EditorText_Lost" KeyDown="EditorText_KeyDown"/>
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6" Padding="8" Background="#FF2F3238">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="130"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Opacity="{Binding RowOpacity}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <TextBlock Foreground="#FFEDEDED" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Foreground="#FFFFC060" Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"/>
                                                                    </StackPanel>
                                                                    <TextBox Grid.Column="1" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="4,3"
                                                                             VerticalAlignment="Center" ToolTip="Price (any text, for example $12, $12 / $16, Market Price)"
                                                                             LostKeyboardFocus="EditorText_Lost" KeyDown="EditorText_KeyDown"/>
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <Button Content="{Binding SoldOutButtonText}" Padding="10,5" Margin="0,0,6,0" MinWidth="96" Command="{Binding ToggleSoldOutCommand}">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding SoldOut}" Value="True">
                                                                                            <Setter Property="Background" Value="#FFD32F2F"/>
                                                                                            <Setter Property="Foreground" Value="White"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                        <Button Content="{Binding VisibilityButtonText}" Padding="10,5" Margin="0,0,6,0" MinWidth="56" Command="{Binding ToggleVisibleCommand}"/>
                                                                        <ToggleButton Content="Edit" Padding="10,5" MinWidth="50" IsChecked="{Binding IsEditing}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                                    <DockPanel Margin="0,0,0,6">
                                                                        <TextBlock Foreground="#FFEDEDED" DockPanel.Dock="Left" Text="Name" Width="80" VerticalAlignment="Center"/>
                                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"
                                                                                 LostKeyboardFocus="EditorText_Lost" KeyDown="EditorText_KeyDown"/>
                                                                    </DockPanel>
                                                                    <DockPanel Margin="0,0,0,6">
                                                                        <TextBlock Foreground="#FFEDEDED" DockPanel.Dock="Left" Text="Description" Width="80" VerticalAlignment="Center"/>
                                                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"
                                                                                 LostKeyboardFocus="EditorText_Lost" KeyDown="EditorText_KeyDown"/>
                                                                    </DockPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <CheckBox Content="Featured" IsChecked="{Binding Featured}" Foreground="#FFEDEDED" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                                        <TextBlock Foreground="#FFEDEDED" Text="Category" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <ComboBox Width="190" ItemsSource="{Binding CategoryChoices}" DisplayMemberPath="Name"
                                                                                  SelectedValuePath="Id" SelectedValue="{Binding CategoryKey}" Margin="0,0,16,0"/>
                                                                        <Button Content="&#9650; Move up" Padding="8,3" Margin="0,0,6,0" Command="{Binding MoveUpCommand}"/>
                                                                        <Button Content="&#9660; Move down" Padding="8,3" Margin="0,0,16,0" Command="{Binding MoveDownCommand}"/>
                                                                        <Button Content="Delete item" Padding="8,3" Command="{Binding DeleteCommand}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Displays">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                <StackPanel DataContext="{Binding Displays}">
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ActionButton}" Content="Identify Displays" Command="{Binding IdentifyCommand}"/>
                            <Button Style="{StaticResource ActionButton}" Content="Refresh" Command="{Binding RefreshCommand}"/>
                            <Button Style="{StaticResource ActionButton}" Content="Forget LED Output" Command="{Binding ClearOutputCommand}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Foreground="#FFEDEDED" Text="DISPLAYS" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
    
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Pick the display connected to the LED controller as the LED output. Numbers 1, 2, 3 are only labels for this list (left to right); Windows display numbers can change, so the app remembers each display by its device ID instead."/>
    
                    <Border Background="#FF7A1F1F" Padding="12,8" Margin="0,0,0,10"
                            Visibility="{Binding HasOutputAlert, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Confirm this display" Padding="10,2" Margin="12,0,0,0"
                                    Command="{Binding ConfirmFallbackCommand}"
                                    Visibility="{Binding NeedsFallbackConfirmation, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Foreground="#FFEDEDED" Text="{Binding OutputAlert}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
    
                    <Border Background="#FF5A4A00" Padding="12,6" Margin="0,0,0,10"
                            Visibility="{Binding HasOperatorNote, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="#FFEDEDED" Text="{Binding OperatorNote}" TextWrapping="Wrap"/>
                    </Border>
    
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FF4A4A4A" BorderThickness="1" Background="#FF262626"
                                        Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="44" FontWeight="Bold"
                                                   Foreground="#FFFFC400" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Foreground="#FFEDEDED" Text="{Binding FriendlyName}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Foreground="#FFEDEDED" Margin="0,2,0,0">
                                                <Run Text="{Binding Resolution, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text="   "/><Run Text="{Binding Scaling, Mode=OneWay}"/>
                                                <Run Text="   "/><Run Text="{Binding Position, Mode=OneWay}"/>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,4">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#FF3E5C76" CornerRadius="3" Padding="8,2" Margin="0,0,6,4">
                                                            <TextBlock Foreground="#FFEDEDED" Text="{Binding}" FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource Dim}" FontSize="11">
                                                <Run Text="Windows name: "/><Run Text="{Binding WindowsName, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap">
                                                <Run Text="Device ID: "/><Run Text="{Binding DeviceId, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                            <Button Content="Use as LED Output" Padding="12,6" Margin="0,0,0,6"
                                                    Command="{Binding SetOutputCommand}"/>
                                            <Button Content="Use as Operator Display" Padding="12,6"
                                                    Command="{Binding SetOperatorCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            </TabItem>
            <TabItem Header="Screens">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                    <StackPanel DataContext="{Binding Screens}">
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource ActionButton}" Content="Remove unused video files" Command="{Binding CleanUpVideoFilesCommand}"
                                        Visibility="{Binding CanManageVideo, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Deletes imported video files that no playlist uses. Videos in a playlist are never touched."/>
                                <Button Style="{StaticResource ActionButton}" Content="Add Screen (168×672)" Command="{Binding AddNarrowCommand}"/>
                                <Button Style="{StaticResource ActionButton}" Margin="0" Content="Add Screen (336×672)" Command="{Binding AddCommand}"/>
                            </StackPanel>
                            <TextBlock Foreground="#FFEDEDED" Text="SCREENS" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="A screen is a rectangle inside the LED output picture, usually one LED wall. The numbers below are the real settings; dragging in the picture just fills them in. Screens that are wrong are flagged and left exactly as you entered them."/>
                        <TextBlock Foreground="#FFEDEDED" Text="{Binding CanvasText}" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold"/>

                        <Border Background="#FF7A1F1F" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2" Margin="12,0,0,0" Command="{Binding DismissSaveErrorCommand}"/>
                                <TextBlock Foreground="#FFEDEDED" Text="{Binding SaveError}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Background="#FF2B4A2B" Padding="12,6" Margin="0,0,0,8"
                                Visibility="{Binding HasVideoMessage, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2" Margin="12,0,0,0" Command="{Binding DismissVideoMessageCommand}"/>
                                <TextBlock Foreground="#FFEDEDED" Text="{Binding VideoMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Background="#FF5A4A00" Padding="12,6" Margin="0,0,0,8"
                                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="#FFEDEDED" Text="{Binding SummaryText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </Border>

                        <Border BorderBrush="#FF4A4A4A" BorderThickness="1" Margin="0,0,0,10">
                            <controls:ScreenCanvasControl x:Name="ScreenCanvas" Height="300" HorizontalAlignment="Stretch"/>
                        </Border>
                        <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,-6,0,10"
                                   Text="Click a rectangle to select it. Drag to move; drag an edge or corner to resize. Edges snap to the canvas and to other screens; hold Alt to turn snapping off."/>

                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="No screens yet. Click &quot;Add Screen (336×672)&quot; to create the expected 2×2 panel wall."
                                   Visibility="{Binding HasNoScreens, Converter={StaticResource BoolToVis}}"/>

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" BorderThickness="2" Padding="12" Margin="0,0,0,10" Background="#FF262626"
                                            BorderBrush="#FF4A4A4A" GotKeyboardFocus="Card_GotFocus" PreviewMouseDown="Card_GotFocus">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" FontSize="36" FontWeight="Bold" Foreground="#FFFFC400" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <DockPanel Margin="0,0,0,8">
                                                    <Button DockPanel.Dock="Right" Content="Remove" Padding="10,3" Margin="8,0,0,0" Command="{Binding RemoveCommand}"/>
                                                    <Button DockPanel.Dock="Right" Content="Set 336×672" Padding="10,3" Margin="8,0,0,0" Command="{Binding StandardSizeCommand}"/>
                                                    <Button DockPanel.Dock="Right" Content="Set 168×672" Padding="10,3" Margin="8,0,0,0" Command="{Binding NarrowSizeCommand}"/>
                                                    <CheckBox DockPanel.Dock="Right" Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                              Foreground="#FFEDEDED" Margin="8,0,0,0"/>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontSize="16" Padding="4,2" KeyDown="CommitOnEnter"/>
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Foreground="#FFEDEDED" Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox Width="76" Padding="3" Text="{Binding X, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter" LostFocus="NumericBox_LostFocus"/>
                                                    <TextBlock Foreground="#FFEDEDED" Text="Y" VerticalAlignment="Center" Margin="14,0,4,0"/>
                                                    <TextBox Width="76" Padding="3" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter" LostFocus="NumericBox_LostFocus"/>
                                                    <TextBlock Foreground="#FFEDEDED" Text="Width" VerticalAlignment="Center" Margin="14,0,4,0"/>
                                                    <TextBox Width="76" Padding="3" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter" LostFocus="NumericBox_LostFocus"/>
                                                    <TextBlock Foreground="#FFEDEDED" Text="Height" VerticalAlignment="Center" Margin="14,0,4,0"/>
                                                    <TextBox Width="76" Padding="3" Text="{Binding Height, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter" LostFocus="NumericBox_LostFocus"/>
                                                </StackPanel>

                                                <!-- what this screen shows -->
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <TextBlock Foreground="#FFEDEDED" Text="Shows" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <RadioButton Style="{StaticResource {x:Type ToggleButton}}" Content="Menu" Padding="16,4" Margin="0,0,6,0"
                                                                 IsChecked="{Binding IsMenuContent}" AutomationProperties.AutomationId="ShowsMenu"/>
                                                    <RadioButton Style="{StaticResource {x:Type ToggleButton}}" Content="Video" Padding="16,4" Margin="0,0,14,0"
                                                                 IsChecked="{Binding IsVideoContent}" AutomationProperties.AutomationId="ShowsVideo"/>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsMenuPicker, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Foreground="#FFEDEDED" Text="Menu" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <ComboBox Width="220" VerticalAlignment="Center" ItemsSource="{Binding MenuChoices}"
                                                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AssignedMenuKey}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- the video playlist (only for a screen that shows video) -->
                                                <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowsVideoEditor, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel DataContext="{Binding Playlist}">
                                                        <DockPanel Margin="0,0,0,6">
                                                            <Button DockPanel.Dock="Right" Content="Add videos…" Padding="14,4" Command="{Binding ImportCommand}"
                                                                    AutomationProperties.AutomationId="AddVideos"/>
                                                            <TextBlock Foreground="#FFEDEDED" Text="VIDEOS, played in this order" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <TextBlock Style="{StaticResource Dim}" Text="{Binding ImportStatus}" Margin="0,0,0,4"/>
                                                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                                   Text="No videos yet. Click “Add videos…”. MP4 with H.264 video is the safest format; sound is ignored."
                                                                   Visibility="{Binding HasNoVideos, Converter={StaticResource BoolToVis}}"/>
                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#FF1E1E1E" Padding="8,6" Margin="0,0,0,4" BorderBrush="#FF3A3A3A" BorderThickness="1">
                                                                        <StackPanel>
                                                                            <DockPanel>
                                                                                <Button DockPanel.Dock="Right" Content="Remove" Padding="8,2" Margin="6,0,0,0" Command="{Binding RemoveCommand}"/>
                                                                                <Button DockPanel.Dock="Right" Content="&#9660;" Padding="8,2" Margin="6,0,0,0" Command="{Binding MoveDownCommand}" ToolTip="Move down"/>
                                                                                <Button DockPanel.Dock="Right" Content="&#9650;" Padding="8,2" Margin="6,0,0,0" Command="{Binding MoveUpCommand}" ToolTip="Move up"/>
                                                                                <CheckBox IsChecked="{Binding Enabled}" Foreground="#FFEDEDED" VerticalAlignment="Center"
                                                                                          ToolTip="Untick to skip this video without removing it">
                                                                                    <TextBlock Foreground="#FFEDEDED" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                                </CheckBox>
                                                                            </DockPanel>
                                                                            <TextBlock Style="{StaticResource Dim}" Text="{Binding Detail}" Margin="22,2,0,0"/>
                                                                            <TextBlock Foreground="#FFFFC060" Text="{Binding Warning}" TextWrapping="Wrap" Margin="22,2,0,0"
                                                                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <CheckBox Content="Start again after the last video" IsChecked="{Binding Loop}" Foreground="#FFEDEDED" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                                            <TextBlock Foreground="#FFEDEDED" Text="A video of another shape:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <RadioButton Style="{StaticResource {x:Type ToggleButton}}" Content="Fit (whole picture)" Padding="10,3" Margin="0,0,4,0" IsChecked="{Binding IsFit}"/>
                                                            <RadioButton Style="{StaticResource {x:Type ToggleButton}}" Content="Fill (crop)" Padding="10,3" IsChecked="{Binding IsFill}"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Button Content="&#9198; Previous" Padding="12,4" Margin="0,0,6,0" Command="{Binding PreviousCommand}" AutomationProperties.AutomationId="VideoPrevious"/>
                                                            <Button Content="{Binding PlayPauseText}" Padding="12,4" Margin="0,0,6,0" Command="{Binding PlayPauseCommand}" AutomationProperties.AutomationId="VideoPlayPause"/>
                                                            <Button Content="Next &#9197;" Padding="12,4" Margin="0,0,12,0" Command="{Binding NextCommand}" AutomationProperties.AutomationId="VideoNext"/>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource Dim}" Text="{Binding LiveStatus}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                                                        <Border Background="#FF5A4A00" Padding="10,6" Margin="0,8,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2" Margin="12,0,0,0" Command="{Binding DismissMessageCommand}"/>
                                                                <TextBlock Foreground="#FFEDEDED" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Foreground="#FFEDEDED" Text="{Binding IssueText}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"
                                                           Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FFFFC060"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                    <Setter Property="Foreground" Value="#FFFF7B7B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#FFC98A12"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#FFD64545"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#FF30343C"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

            </TabItem>
            <TabItem Header="Menu Library">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                    <StackPanel DataContext="{Binding Menus}">
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource ActionButton}" Content="New Menu" Command="{Binding NewMenuCommand}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Foreground="#FFEDEDED" Text="MENUS" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Add a sample:" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource Dim}"/>
                            <ItemsControl ItemsSource="{Binding Samples}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Title}" ToolTip="{Binding Purpose}" Padding="10,4" Margin="0,0,6,4"
                                                Command="{Binding DataContext.AddSampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="A menu is content only: a name, header, optional logo, categories and items. It is shown on a screen by choosing it in the Screens tab, so the same menu can move to another screen without changing the screen layout. Changes save automatically. Edit categories and items on the Menu tab."/>

                        <Border Background="#FF8A5A00" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding HasLoadNotice, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="#FFEDEDED" Text="{Binding LoadNotice}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#FF7A1F1F" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2" Margin="12,0,0,0" Command="{Binding DismissMessageCommand}"/>
                                <TextBlock Foreground="#FFEDEDED" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10"
                                   Text="No menus yet. Click &quot;New Menu&quot; or &quot;New Sample Menu&quot;."
                                   Visibility="{Binding HasNoMenus, Converter={StaticResource BoolToVis}}"/>

                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="2" Padding="12" Margin="0,0,0,10" Background="#FF262626" BorderBrush="#FF4A4A4A">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Content="Delete" Padding="10,3" Margin="8,0,0,0" Command="{Binding DeleteCommand}"/>
                                                <TextBlock Foreground="#FFEDEDED" DockPanel.Dock="Left" Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" Width="60"/>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontSize="16" Padding="4,2" KeyDown="CommitOnEnter"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Foreground="#FFEDEDED" DockPanel.Dock="Left" Text="Header" VerticalAlignment="Center" Margin="0,0,8,0" Width="60"/>
                                                <TextBox Text="{Binding HeaderText, UpdateSourceTrigger=LostFocus}" Padding="4,2" KeyDown="CommitOnEnter"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Foreground="#FFEDEDED" DockPanel.Dock="Left" Text="Subtitle" VerticalAlignment="Center" Margin="0,0,8,0" Width="60"/>
                                                <TextBox Text="{Binding Subtitle, UpdateSourceTrigger=LostFocus}" Padding="4,2" KeyDown="CommitOnEnter"/>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Button Content="Set Logo..." Padding="10,3" Margin="0,0,8,0" Command="{Binding SetLogoCommand}"/>
                                                <Button Content="Remove Logo" Padding="10,3" Margin="0,0,12,0" Command="{Binding RemoveLogoCommand}"/>
                                                <TextBlock Text="{Binding LogoText}" VerticalAlignment="Center" Style="{StaticResource Dim}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Foreground="#FFEDEDED" Text="Seconds per page" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Width="60" Padding="3" Text="{Binding PageSeconds, UpdateSourceTrigger=LostFocus}"
                                                         KeyDown="CommitOnEnter" LostFocus="NumericBox_LostFocus" ToolTip="2 to 120. Only matters when a menu needs more than one page."/>
                                                <CheckBox Content="Show page numbers" IsChecked="{Binding ShowPageIndicator}" Foreground="#FFEDEDED" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Foreground="#FFEDEDED" Text="{Binding Summary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding UsedBy}" Style="{StaticResource Dim}"/>
                                            <TextBlock Text="{Binding IssueText}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#FFFFC060"
                                                       Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}"/>
                                            <Expander Header="Preview (the same pages the LED shows)" IsExpanded="{Binding IsPreviewOpen, Mode=TwoWay}"
                                                      Foreground="#FFEDEDED" Margin="0,10,0,0">
                                                <StackPanel Margin="0,8,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Button Content="&#9664; Previous page" Padding="10,3" Margin="0,0,6,0" Command="{Binding PreviousPageCommand}"/>
                                                        <Button Content="Next page &#9654;" Padding="10,3" Margin="0,0,6,0" Command="{Binding NextPageCommand}"/>
                                                        <Button Content="Follow LED" Padding="10,3" Margin="0,0,16,0" Command="{Binding FollowCommand}"/>
                                                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Dim}"/>
                                                        <Button Content="1&#215;" Padding="10,3" Margin="0,0,4,0" Command="{Binding Zoom1Command}"/>
                                                        <Button Content="2&#215;" Padding="10,3" Margin="0,0,4,0" Command="{Binding Zoom2Command}"/>
                                                        <Button Content="3&#215;" Padding="10,3" Command="{Binding Zoom3Command}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
                                                    <TextBlock Text="{Binding PreviewProblems}" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="#FFFFC060"
                                                               Visibility="{Binding HasPreviewProblems, Converter={StaticResource BoolToVis}}"/>
                                                    <Border Background="Black" BorderBrush="#FF666666" BorderThickness="1" HorizontalAlignment="Left" Padding="0">
                                                        <controls:PixelFrameControl Frame="{Binding PreviewFrame}" Zoom="{Binding Zoom}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Help">
                <StackPanel Margin="12">
                    <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Border Background="#FF262626" Padding="12,8" Margin="0,0,0,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="150" Text="Ctrl+Shift+B" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Blackout" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Text="Turns the LED output pure black, and back. Menus and settings are untouched. Works from anywhere while output is running, even when another program has focus."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="#FF262626" Padding="12,8" Margin="0,0,0,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="150" Text="Ctrl+Shift+I" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Identify Screens" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Text="Shows each screen's number and outline on the LED output for 15 seconds, then returns to Normal Output. Works from anywhere while output is running."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="#FF262626" Padding="12,8" Margin="0,0,0,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="150" Text="Ctrl+Shift+F12" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Stop Output (emergency recovery)" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Text="Closes the LED output window without closing the program. Works even when another program has focus or the output covers this window."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="#FF262626" Padding="12,8" Margin="0,0,0,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="150" Text="Esc" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Stop Output" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Text="Only when the LED output window itself has focus. The output never takes focus on its own."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Nothing here deletes anything. Blackout only works while output is running."/>
                </StackPanel>
            </TabItem>
        </TabControl>
            <Border Grid.Column="1" Width="436" Background="#FF1E1E1E" BorderBrush="#FF4A4A4A" BorderThickness="1" Padding="10"
                    DataContext="{Binding Preview}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,4">
                            <Border DockPanel.Dock="Right" CornerRadius="3" Padding="8,2" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FF555555"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter Property="Background" Value="#FFC62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="White" Text="{Binding LiveText}" FontWeight="Bold" FontSize="12"/>
                            </Border>
                            <TextBlock Foreground="#FFEDEDED" Text="PREVIEW" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Dim}" Text="{Binding CanvasDescription}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Dim}" Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Border Background="Black" BorderBrush="#FF666666" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <controls:ScaledFrameControl AutomationProperties.AutomationId="PreviewImage"
                                                         Frame="{Binding Frame}" Region="{Binding Region}" Scale="{Binding Scale}" Revision="{Binding Revision}"/>
                        </Border>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="16,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Version, StringFormat=v{0}}" Style="{StaticResource Dim}"/>
            <TextBlock Text="{Binding DataFolder, StringFormat=Data: {0}}" Style="{StaticResource Dim}"/>
        </DockPanel>
    </Grid>
</Window>
