<Window x:Class="LedMenu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LED Menu Control" Height="720" Width="1100" MinHeight="480" MinWidth="720"
        Background="#FF1E1E1E" Foreground="#FFEDEDED">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="16,12">
            <Border DockPanel.Dock="Right" Background="#FF3A3A3A" CornerRadius="4" Padding="12,4">
                <TextBlock Text="{Binding OutputStatus}" FontWeight="Bold" FontSize="14"/>
            </Border>
            <TextBlock Text="LED MENU CONTROL" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Recovery / startup notice -->
        <Border Grid.Row="1" Background="#FF8A5A00" Padding="16,8" Margin="16,0,16,8"
                Visibility="{Binding HasStartupNotice, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2"
                        Command="{Binding DismissNoticeCommand}"/>
                <TextBlock Text="{Binding StartupNotice}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Main area (menu list + preview arrive in later phases) -->
        <Grid Grid.Row="2" Margin="16,0">
            <Border BorderBrush="#FF3A3A3A" BorderThickness="1" Padding="24">
                <TextBlock Text="Menu editing and live preview will appear here."
                           FontSize="16" Foreground="#FF9A9A9A"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="16,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Version, StringFormat=v{0}}" Foreground="#FF9A9A9A"/>
            <TextBlock Text="{Binding DataFolder, StringFormat=Data: {0}}" Foreground="#FF9A9A9A"/>
        </DockPanel>
    </Grid>
</Window>

