<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LedMenu.Core\LedMenu.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Bundled fonts travel with every project that references the renderer (the app and the tests). -->
  <ItemGroup>
    <None Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
